{
  "apiVersion": "tcg/v1alpha1",
  "kind": "TelemetrySnapshot",
  "metadata": {
    "name": "checkout-main"
  },
  "spec": {
    "domain": "prometheus",
    "metrics": [
      {
        "name": "checkout_requests_total",
        "type": "counter",
        "unit": "requests",
        "labels": [
          "method",
          "status"
        ]
      },
      {
        "name": "checkout_workers",
        "type": "gauge",
        "labels": [
          "job",
          "zone"
        ]
      }
    ]
  }
}
